# Copy to .env.local (never commit real values).
# Phase 2 — Supabase (the anon/publishable key is designed to be public; RLS protects data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 4 — Gemini. SERVER-SIDE ONLY. Never prefix with VITE_ (that would ship it to the browser).
# Set this in Netlify / Supabase secrets, not in this file.
# GEMINI_API_KEY=
